---
import { FileText, Menu, X } from '@lucide/astro';
import { getLangFromUrl, getRelativeLangUrl } from '@/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const base = import.meta.env.BASE_URL;
const ptUrl = getRelativeLangUrl(Astro.url, 'pt', base);
const enUrl = getRelativeLangUrl(Astro.url, 'en', base);
const resumeUrl = `${base}${lang}/resume/`;
---

<header
  id="home-nav"
  class="fixed top-0 left-0 right-0 h-16 z-50 flex items-center bg-surface/80 backdrop-blur-md border-b border-edge transition-all"
>
  <div class="max-w-6xl mx-auto w-full px-6 flex items-center justify-between">
    <a
      href={`${base}${lang}/`}
      class="font-black text-base bg-gradient-to-r from-accent-600 to-pink-600 bg-clip-text text-transparent tracking-tight"
      style="font-family: 'Press Start 2P', monospace; font-size: 12px;"
    >
      &lt;panizio /&gt;
    </a>

    <nav class="hidden md:flex items-center gap-1">
      <a href="#about" class="px-3 py-2 text-sm font-medium text-ink-body hover:text-accent-600 transition-colors rounded-md hover:bg-surface-dim" data-i18n="home.nav.about"></a>
      <a href="#projects" class="px-3 py-2 text-sm font-medium text-ink-body hover:text-accent-600 transition-colors rounded-md hover:bg-surface-dim" data-i18n="home.nav.projects"></a>
      <a href="#contact" class="px-3 py-2 text-sm font-medium text-ink-body hover:text-accent-600 transition-colors rounded-md hover:bg-surface-dim" data-i18n="home.nav.contact"></a>
      <a
        href={resumeUrl}
        class="ml-3 flex items-center gap-2 bg-surface-dark hover:bg-surface-darker text-white px-4 py-2 rounded-full text-xs font-bold transition-all shadow-sm"
      >
        <FileText size={13} />
        <span data-i18n="home.nav.resume"></span>
      </a>
      <div class="ml-2 bg-surface border-edge shadow-sm flex items-center border rounded-full overflow-hidden p-0.5">
        <a href={ptUrl} class={`px-3 py-1 rounded-full text-xs font-bold transition-all ${lang === 'pt' ? 'bg-accent-600 text-white' : 'text-ink-subtle hover:text-ink-body'}`}>PT</a>
        <a href={enUrl} class={`px-3 py-1 rounded-full text-xs font-bold transition-all ${lang === 'en' ? 'bg-accent-600 text-white' : 'text-ink-subtle hover:text-ink-body'}`}>EN</a>
      </div>
    </nav>

    <button
      id="menu-toggle"
      class="md:hidden p-2 text-ink-body hover:text-accent-600 transition-colors"
      data-i18n-aria-label="home.nav.menu_aria"
    >
      <span id="icon-menu"><Menu size={20} /></span>
      <span id="icon-close" class="hidden"><X size={20} /></span>
    </button>
  </div>
</header>

<div
  id="mobile-menu"
  class="fixed top-16 left-0 right-0 z-40 bg-surface border-b border-edge shadow-lg hidden md:hidden"
>
  <nav class="flex flex-col px-6 py-2">
    <a href="#about" class="mobile-nav-link px-3 py-3.5 text-sm font-medium text-ink-body hover:text-accent-600 border-b border-edge-faint transition-colors" data-i18n="home.nav.about"></a>
    <a href="#projects" class="mobile-nav-link px-3 py-3.5 text-sm font-medium text-ink-body hover:text-accent-600 border-b border-edge-faint transition-colors" data-i18n="home.nav.projects"></a>
    <a href="#contact" class="mobile-nav-link px-3 py-3.5 text-sm font-medium text-ink-body hover:text-accent-600 border-b border-edge-faint transition-colors" data-i18n="home.nav.contact"></a>
    <a href={resumeUrl} class="px-3 py-3.5 text-sm font-bold text-accent-600 flex items-center gap-2 border-b border-edge-faint">
      <FileText size={14} />
      <span data-i18n="home.nav.resume"></span>
    </a>
    <div class="px-3 py-3.5 flex gap-2">
      <a href={ptUrl} class={`px-3 py-1 rounded-full text-xs font-bold border transition-all ${lang === 'pt' ? 'bg-accent-600 text-white border-accent-600' : 'border-edge text-ink-subtle hover:text-ink-body'}`}>PT</a>
      <a href={enUrl} class={`px-3 py-1 rounded-full text-xs font-bold border transition-all ${lang === 'en' ? 'bg-accent-600 text-white border-accent-600' : 'border-edge text-ink-subtle hover:text-ink-body'}`}>EN</a>
    </div>
  </nav>
</div>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');

  function closeMenu() {
    menu?.classList.add('hidden');
    iconMenu?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
  }

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    if (isOpen) {
      closeMenu();
    } else {
      menu?.classList.remove('hidden');
      iconMenu?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
    }
  });

  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', closeMenu);
  });
</script>
