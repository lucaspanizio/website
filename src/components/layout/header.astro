---
import { cn } from '@/lib/cn';

interface Props {
  id?: string;
  class?: string;
}

const { id, class: className } = Astro.props;
---

<header
  id={id}
  class={cn('fixed top-0 left-0 right-0 h-16 flex items-center bg-surface/80 backdrop-blur-md border-b border-edge transition-all z-50', className)}
>
  <div class="max-w-6xl mx-auto w-full px-6 flex items-center justify-between">
    <slot />
  </div>
</header>
