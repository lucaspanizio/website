---
import { Printer } from '@lucide/astro';
---

<header
  class="fixed top-0 left-0 right-0 h-16 z-40 print:hidden flex items-center justify-center gap-3 md:gap-4 px-4 bg-inherit bg-opacity-80 backdrop-blur-md border-b border-edge"
>
  <div
    class="bg-surface border-edge shadow-sm flex items-center border rounded-full overflow-hidden p-0.5"
  >
    <button
      class="px-3 py-1 rounded-full text-xxs md:text-xs font-bold transition-all bg-accent-600 text-white"
    >
      PT
    </button>
    <button
      class="px-3 py-1 rounded-full text-xxs md:text-xs font-bold transition-all text-ink-subtle hover:text-ink-body"
    >
      EN
    </button>
  </div>
  <button
    id="print-btn"
    class="bg-surface-dark hover:bg-surface-darker flex items-center gap-2 px-3 md:px-4 py-1.5 text-white border-none rounded-full text-xxs md:text-xs font-bold transition-all shadow-sm disabled:opacity-60 disabled:cursor-not-allowed"
  >
    <Printer size={14} />
    SALVAR PDF
  </button>
</header>

<script>
  const btn = document.getElementById('print-btn') as HTMLButtonElement | null;
  if (btn) {
    const origHTML = btn.innerHTML;

    btn.addEventListener('click', () => window.print());

    window.addEventListener('beforeprint', () => {
      btn.disabled = true;
    });

    window.addEventListener('afterprint', () => {
      btn.disabled = false;
      btn.innerHTML = origHTML;
    });
  }
</script>
