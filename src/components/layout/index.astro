---
import '@/styles/global.css';

import interLatinWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import pressStart2pLatinWoff2 from '@fontsource/press-start-2p/files/press-start-2p-latin-400-normal.woff2?url';

import { GA_MEASUREMENT_ID } from '@/data/config';

const enableAnalytics = import.meta.env.ENABLE_ANALYTICS === 'true';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Panizio Dev',
  description = 'Website para apresentação pessoal, portifólio, currículo e meios de contato.',
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR" translate="no">
  <head>
    <link rel="preload" as="font" type="font/woff2" href={interLatinWoff2} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={pressStart2pLatinWoff2} crossorigin />
    <script is:inline>
      (function () {
        var s = localStorage.getItem('theme');
        var p = window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (s === 'dark' || (!s && p)) document.documentElement.classList.add('dark');
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google" content="notranslate" />
    <link rel="icon" type="image/png" href={`${import.meta.env.BASE_URL}favicon.png`} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="front-end, desenvolvedor, react, typescript, design system, web" />
    <meta name="author" content="José Lucas Panizio" />
    <meta name="creator" content="José Lucas Panizio" />
    <meta name="robots" content="index, follow" />
    <meta name="language" content="Portuguese" />

    <!-- Open Graph -->
    <meta property="og:type" content="profile" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:url" content="https://panizio.is-a.dev" />
    <meta property="og:site_name" content="José Lucas Panizio" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Canonical -->
    <link rel="canonical" href="https://panizio.is-a.dev" />

    {enableAnalytics && (
      <>
        <script async is:inline src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
        <script is:inline define:vars={{ GA_MEASUREMENT_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', GA_MEASUREMENT_ID);
        </script>
      </>
    )}
  </head>

  <body class="min-h-screen flex flex-col selection:bg-accent-600 selection:text-white">
    <slot />
  </body>
</html>
