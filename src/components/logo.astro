---
import { cn } from '@/lib/cn';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const baseUrl = import.meta.env.BASE_URL;
---

<a
  href={baseUrl}
  class={cn('font-black text-base bg-gradient-to-r from-accent-600 to-pink-600 bg-clip-text text-transparent tracking-tight', className)}
  style="font-family: 'Press Start 2P', monospace; font-size: 12px;"
>
  &lt;panizio /&gt;
</a>
