---
interface Props {
  title: string;
  institution: string;
  period: string;
  description: string;
  i18nPrefix?: string;
}

const { title, institution, period, description, i18nPrefix } = Astro.props;
---

<div class="pt-4 print:pt-3">
  <div class="flex justify-between items-start mb-1">
    <h3
      class="text-ink-title font-bold text-sm sm:text-base"
      data-i18n={i18nPrefix ? `${i18nPrefix}.title` : undefined}
    >{title}</h3>
    <span
      class="text-xxs sm:text-xs text-ink-muted font-mono italic whitespace-nowrap ml-4"
      data-i18n={i18nPrefix ? `${i18nPrefix}.period` : undefined}
    >{period}</span>
  </div>
  <p class="text-accent-600 text-xxs sm:text-xs uppercase tracking-wider font-bold mb-3">{institution}</p>
  <p
    class="text-ink-body text-xs sm:text-sm leading-tight"
    data-i18n={i18nPrefix ? `${i18nPrefix}.desc` : undefined}
  >{description}</p>
</div>
