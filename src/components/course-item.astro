---
interface Props {
  titleKey: string;
  periodKey: string;
  descKey: string;
  institution: string;
}

const { titleKey, periodKey, descKey, institution } = Astro.props;
---

<div class="pt-4 print:pt-3">
  <div class="flex justify-between items-start mb-1">
    <h3 class="text-ink-title font-bold text-sm sm:text-base" data-i18n={titleKey}></h3>
    <span class="text-xxs sm:text-xs text-ink-muted font-mono italic whitespace-nowrap ml-4" data-i18n={periodKey}></span>
  </div>
  <p class="text-accent-600 text-xxs sm:text-xs uppercase tracking-wider font-bold mb-3">{institution}</p>
  <p class="text-ink-body text-xs sm:text-sm leading-tight" data-i18n={descKey}></p>
</div>
