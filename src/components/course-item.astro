---
interface Props {
  title: string;
  institution: string;
  period: string;
  description: string;
}

const { title, institution, period, description } = Astro.props;
---

<div class="border-edge-faint border-b py-4 last:border-0 group print:py-4 print-break-inside-avoid">
  <div class="flex justify-between items-start mb-1">
    <h3 class="text-ink-title font-bold text-sm sm:text-base">{title}</h3>
    <span class="text-xxs sm:text-xs text-ink-muted font-mono italic whitespace-nowrap ml-4">{period}</span>
  </div>
  <p class="text-accent-600 text-xxs sm:text-xs uppercase tracking-wider font-bold mb-3">{institution}</p>
  <p class="text-ink-body text-xs sm:text-sm leading-tight">{description}</p>
</div>
