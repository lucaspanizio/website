---
import { ExternalLink } from '@lucide/astro';
import GithubIcon from '@/components/icons/GithubIcon.astro';
import type { Project } from '@/lib/github';
import type { ProjectType } from '@/data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;

const typeStyle: Record<ProjectType, string> = {
  frontend: 'bg-accent-50 border-accent-100 text-accent-700 dark:bg-accent-600/20 dark:border-accent-600/30 dark:text-accent-400',
  backend: 'bg-success-50 border-success-100 text-success-700 dark:bg-success-600/20 dark:border-success-600/30 dark:text-success-400',
  mobile: 'bg-purple-50 border-purple-100 text-purple-700 dark:bg-purple-600/20 dark:border-purple-600/30 dark:text-purple-400',
  library: 'bg-surface-tint border-edge text-ink-muted',
};
---

<div class="border border-edge-faint rounded-lg p-4 flex flex-col gap-3 hover:border-accent-600/40 hover:shadow-sm transition-all bg-surface">
  <div class="flex items-start justify-between gap-2">
    <div class="flex items-center gap-2 flex-wrap">
      <h3 class="text-ink-title font-bold text-sm">{project.name}</h3>
      <span class={`text-[9px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded border ${typeStyle[project.type]}`}>
        {project.type}
      </span>
    </div>
    <div class="flex gap-2 shrink-0 mt-0.5">
      <a
        href={project.repoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-ink-muted hover:text-accent-700 transition-colors"
        title="Repositório"
      >
        <GithubIcon size={14} />
      </a>
      {project.demo && (
        <a
          href={project.demo}
          target="_blank"
          rel="noopener noreferrer"
          class="text-ink-muted hover:text-accent-700 transition-colors"
          title="Demo online"
        >
          <ExternalLink size={14} />
        </a>
      )}
    </div>
  </div>

  <p class="text-ink-body text-xs leading-relaxed flex-1">{project.desc}</p>

  <div class="flex flex-wrap gap-1">
    {project.tags.map((tag) => (
      <span class="bg-surface-tint border-edge text-ink-muted px-2 py-0.5 border rounded text-[9px] uppercase font-bold tracking-wider">
        {tag}
      </span>
    ))}
  </div>
</div>
