---
import { Github, Phone, Mail, BriefcaseBusiness, Linkedin } from '@lucide/astro';
import SocialLink from './social-link.astro';
---

<div
  class="bg-surface border-edge mb-6 p-8 rounded-lg border shadow-xl print:shadow-none print:border-edge-soft print-break-inside-avoid"
>
  <div class="grid grid-cols-1 md:grid-cols-[1fr_auto] gap-x-10 gap-y-6">
    <div class="space-y-2">
      <h1 class="text-accent-700 text-xl sm:text-2xl font-black uppercase tracking-wide">
        JOSÉ LUCAS PANIZIO
      </h1>

      <p class="text-ink-subtle font-mono text-sm sm:text-base italic">
        Desenvolvedor Frontend
      </p>

      <!-- Mobile (texto resumido com expansão) -->
      <div class="sm:hidden">
        <div class="text-ink-body text-xs leading-relaxed max-w-3xl">
          <p id="about-short">
            Desenvolvedor Frontend com mais de 4 anos de experiência na construção e evolução de aplicações web com React e TypeScript, com foco em performance, qualidade de código e experiência do usuário.
          </p>
          <p id="about-rest" class="hidden mt-2">
            Atuo em times ágeis, participando de discussões técnicas, definição de padrões, code reviews e treinamentos internos, contribuindo para a qualidade das entregas e a evolução contínua das aplicações e do time. Atualmente venho me aprofundando em Node.js com o objetivo de evoluir para um perfil fullstack.
          </p>
        </div>
        <button
          id="about-toggle"
          class="text-accent-700 text-xs font-bold mt-1"
          type="button"
        >
          ver mais...
        </button>
      </div>

      <!-- Desktop/Tablet (texto completo) -->
      <div class="hidden sm:block pt-2 space-y-3">
        <p class="text-ink-body text-sm leading-relaxed max-w-3xl">
          Desenvolvedor Frontend com mais de 4 anos de experiência na construção e evolução de
          aplicações web com React e TypeScript, com foco em performance, qualidade de código e
          experiência do usuário, sempre alinhado às necessidades do produto.
        </p>
        <p class="text-ink-body text-sm leading-relaxed max-w-3xl">
          Atuo em times ágeis, participando de discussões técnicas, definição de padrões, code
          reviews e treinamentos internos, contribuindo para a qualidade das entregas e a evolução
          contínua das aplicações e do time. Atualmente venho me aprofundando em Node.js com o
          objetivo de evoluir para um perfil fullstack.
        </p>
      </div>
    </div>

    <div id="social-links" class="grid grid-cols-1 max-md:grid-cols-2 gap-3">
      <SocialLink
        title="Portfolio"
        username="panizio.is-a.dev"
        url="https://panizio.is-a.dev"
        icon={BriefcaseBusiness}
      />

      <SocialLink
        title="LinkedIn"
        username="lucaspanizio"
        url="https://linkedin.com/in/lucaspanizio"
        icon={Linkedin}
      />

      <SocialLink
        title="GitHub"
        username="lucaspanizio"
        url="https://github.com/lucaspanizio"
        icon={Github}
      />

      <SocialLink
        title="WhatsApp"
        username="+55 43 99625-5495"
        url="https://wa.me/5543996255495"
        icon={Phone}
      />

      <SocialLink
        title="Email"
        username="lucaspanizio@gmail.com"
        url="mailto:lucaspanizio@gmail.com"
        icon={Mail}
      />
    </div>
  </div>
</div>

<script is:inline>
  const toggle = document.getElementById('about-toggle');
  const rest = document.getElementById('about-rest');
  if (toggle && rest) {
    toggle.addEventListener('click', () => {
      const isHidden = rest.classList.toggle('hidden');
      toggle.textContent = isHidden ? 'ver mais...' : 'ver menos';
    });
  }
</script>

