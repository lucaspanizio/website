---
import { Award } from '@lucide/astro';
import CourseItem from '../../../components/course-item.astro';
---

<aside
  class="h-full bg-surface border-edge border p-6 rounded-lg shadow-xl print:shadow-none print:border-edge-soft"
>
  <h2
    class="text-accent-700 border-edge-faint font-black tracking-widest text-xs uppercase mb-6 border-b pb-2 flex items-center gap-2"
  >
    <Award size={14} />
    <span data-i18n="course.title">CURSOS E CERTIFICAÇÕES</span>
  </h2>
  <div class="divide-y divide-edge-faint">
    <CourseItem
      i18nPrefix="course.0"
      title="Node.js"
      institution="Rocketseat"
      period="Em andamento · 73h"
      description="Curso de Node.js voltado ao desenvolvimento backend com JavaScript, abordando criação de servidores, APIs REST, autenticação, integração com banco de dados e ecossistema Node."
    />

    <CourseItem
      i18nPrefix="course.1"
      title="Next.js"
      institution="Rocketseat"
      period="2026 · 45h"
      description="Curso voltado ao desenvolvimento de aplicações com Next.js, abordando SSR, SSG, ISR, roteamento via pages e app router e Server Components."
    />

    <CourseItem
      i18nPrefix="course.2"
      title="Angular"
      institution="Rocketseat"
      period="Jan 2026 · 11h"
      description="Curso introdutório de Angular v21, com abordagem da estrutura do framework, componentes e fluxo básico de dados."
    />

    <CourseItem
      i18nPrefix="course.3"
      title="Tailwind CSS"
      institution="Origamid"
      period="Ago 2025 · 16h"
      description="Curso voltado a construção de layouts responsivos com Tailwind CSS v4, incluindo customização de tema e composição de utilitários."
    />

    <CourseItem
      i18nPrefix="course.4"
      title="Javascript ES6"
      institution="Origamid"
      period="Jul 2025 · 74h"
      description="Curso de JavaScript moderno (ES6+), abrangendo módulos, closures, manipulação do DOM, consumo de APIs com fetch e programação assíncrona."
    />

    <CourseItem
      i18nPrefix="course.5"
      title="React Profissional"
      institution="Udemy"
      period="Abr 2025 · 27h"
      description="Curso de React com foco em Styled Components, documentação de componentes com Storybook e testes automatizados com Jest."
    />

    <CourseItem
      i18nPrefix="course.6"
      title="React.js"
      institution="Rocketseat"
      period="Mar 2025 · 50h"
      description="Curso completo sobre o ecossistema React, incluindo componentes, estado, integração com bibliotecas, testes e processos de build e deploy."
    />

    <CourseItem
      i18nPrefix="course.7"
      title="Comunicação e Oratória"
      institution="Retoricamente"
      period="Set 2023 · 16h"
      description="Curso de comunicação e oratória em contexto profissional com teoria e prática sob mentoria de Cinthia Erika."
    />
  </div>
</aside>
