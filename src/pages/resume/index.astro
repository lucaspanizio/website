---
import Layout from '../../components/layout/index.astro';
import Header from '../../components/layout/header.astro';
import Footer from '../../components/layout/footer.astro';

import HeroSection from './sections/hero-section.astro';
import CourseSection from './sections/course-section.astro';
import GraduationSection from './sections/graduation-section.astro';
import ExperienceSection from './sections/experience-section.astro';
import ProjectSection from './sections/project-section.astro';
---

<Layout
  title="Currículo - Panizio Dev"
  description="Confira meu currículo."
>
  <Header />

  <main class="max-w-[1200px] mx-auto px-4 pt-24 pb-8">
    <HeroSection />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
      <div class="lg:col-span-7 flex flex-col gap-6">
        <GraduationSection />
        <ExperienceSection />
      </div>      
      
     <CourseSection />
    </div>

    <ProjectSection />
  </main>

  <Footer />
</Layout>
