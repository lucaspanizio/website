---
import { Mail, BriefcaseBusiness } from '@lucide/astro';
import GithubIcon from '@/components/icons/GithubIcon.astro';
import LinkedinIcon from '@/components/icons/LinkedinIcon.astro';
import WhatsappIcon from '@/components/icons/WhatsappIcon.astro';
import SocialLink from '@/components/social-link.astro';
---

<section class="bg-surface border-edge mb-6 p-8 rounded-lg border shadow-xl grid grid-cols-1 md:grid-cols-[1fr_auto] gap-x-10 gap-y-6">
  <div class="space-y-2">
    <h1 class="text-accent-600 text-xl sm:text-2xl font-black uppercase tracking-wide">
      José Lucas Panizio
    </h1>

    <p class="text-ink-subtle dark:text-ink-muted font-mono text-sm sm:text-base italic">Desenvolvedor de Software</p>

    <!-- Mobile -->
    <div class="sm:hidden">
      <div class="text-ink-body text-xs leading-relaxed max-w-3xl">
        <p id="about-short">Atuo principalmente no frontend, construindo e evoluindo aplicações web com React e TypeScript, com foco em performance, qualidade de código e experiência do usuário, sempre alinhado às necessidades do produto.</p>
        <p id="about-rest" class="hidden mt-2">Também participo de discussões técnicas, code reviews, definição de padrões, e iniciativas que contribuem para a evolução contínua dos produtos. Paralelamente, venho aprofundando meus conhecimentos em Node.js para expandir minha atuação no backend.</p>
      </div>
      <button
        id="about-toggle"
        data-read-more="ver mais..."
        data-read-less="ver menos"
        class="text-accent-700 text-xs font-bold mt-1"
        type="button"
      >ver mais...</button>
    </div>

    <!-- Desktop/Tablet -->
    <div class="hidden sm:block pt-2 space-y-3">
      <p class="text-ink-body text-sm leading-relaxed max-w-3xl">Atuo principalmente no frontend, construindo e evoluindo aplicações web com React e TypeScript, com foco em performance, qualidade de código e experiência do usuário, sempre alinhado às necessidades do produto.</p>
      <p class="text-ink-body text-sm leading-relaxed max-w-3xl">Também participo de discussões técnicas, code reviews, definição de padrões, e iniciativas que contribuem para a evolução contínua dos produtos. Paralelamente, venho aprofundando meus conhecimentos em Node.js para expandir minha atuação no backend.</p>
    </div>
  </div>

  <div id="social-links" class="grid grid-cols-1 max-md:grid-cols-2 gap-3">
    <SocialLink
      title="Portfolio"
      username="panizio.is-a.dev"
      url="https://panizio.is-a.dev"
      icon={BriefcaseBusiness}
    />
    <SocialLink
      title="LinkedIn"
      username="lucaspanizio"
      url="https://linkedin.com/in/lucaspanizio"
      icon={LinkedinIcon}
    />
    <SocialLink
      title="GitHub"
      username="lucaspanizio"
      url="https://github.com/lucaspanizio"
      icon={GithubIcon}
    />
    <SocialLink
      title="WhatsApp"
      username="+55 43 99625-5495"
      url="https://wa.me/5543996255495"
      icon={WhatsappIcon}
    />
    <SocialLink
      title="Email"
      username="lucaspanizio@gmail.com"
      url="mailto:lucaspanizio@gmail.com"
      icon={Mail}
    />
  </div>
</section>

<script>
  const toggle = document.getElementById('about-toggle') as HTMLButtonElement | null;
  const rest = document.getElementById('about-rest');
  if (toggle && rest) {
    toggle.addEventListener('click', () => {
      const isHidden = rest.classList.toggle('hidden');
      toggle.textContent = isHidden ? toggle.dataset.readMore! : toggle.dataset.readLess!;
    });
  }
</script>
