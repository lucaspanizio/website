---
import { Award } from '@lucide/astro';
import CourseItem from '@/components/course-item.astro';

const courses = [
  { institution: 'Rocketseat', title: 'Node.js', period: 'Em andamento · 73h', desc: 'Curso de Node.js voltado ao desenvolvimento de aplicações back-end com JavaScript, abordando criação de APIs REST, autenticação, integração com bancos de dados, arquitetura de aplicações e ecossistema Node.js.' },
  { institution: 'Rocketseat', title: 'Segurança para Devs', period: 'Ago 2026 · 30h', desc: 'Curso sobre desenvolvimento seguro de aplicações web, cobrindo autenticação, HTTP, mitigação das principais vulnerabilidades OWASP, validação de entradas, serialização segura e fundamentos de proteção em front-end, back-end e infraestrutura.' },
  { institution: 'Rocketseat', title: 'Dev com IA', period: 'Jun 2026 · 10h', desc: 'Curso voltado à aplicação de IA no desenvolvimento de software, utilizando ferramentas como Claude Code, Codex e Cursor para automação, geração de código, revisão de código e aumento de produtividade.' },
  { institution: 'Rocketseat', title: 'Angular', period: 'Jan 2026 · 11h', desc: 'Curso introdutório de Angular v21, abordando a arquitetura do framework, componentes, templates, data binding e gerenciamento básico de estado e navegação.' },
  { institution: 'Origamid', title: 'Tailwind CSS', period: 'Ago 2025 · 16h', desc: 'Curso voltado ao desenvolvimento de interfaces responsivas com Tailwind CSS v4, abordando composição de utilitários, customização de temas e boas práticas de estilização.' },
  { institution: 'Origamid', title: 'Javascript ES6', period: 'Jul 2025 · 74h', desc: 'Curso de JavaScript moderno (ES6+), abrangendo módulos, closures, manipulação do DOM, consumo de APIs com fetch e programação assíncrona.' },
  { institution: 'Udemy', title: 'React Profissional', period: 'Abr 2025 · 27h', desc: 'Curso de React com foco em Styled Components, documentação de componentes com Storybook e testes automatizados com Jest.' },
  { institution: 'Rocketseat', title: 'React.js', period: 'Mar 2025 · 50h', desc: 'Curso completo sobre o ecossistema React, incluindo componentes, estado, integração com bibliotecas, testes e processos de build e deploy.' },
  { institution: 'Retoricamente', title: 'Comunicação e Oratória', period: 'Set 2023 · 16h', desc: 'Curso de comunicação e oratória em contexto profissional com teoria e prática sob mentoria de Cinthia Erika.' },
];
---

<aside class="lg:col-span-5 h-full bg-surface border-edge border p-6 rounded-lg shadow-xl">
  <h2
    class="text-accent-600 border-edge-faint font-black tracking-widest text-xs uppercase mb-4 border-b pb-2 flex items-center gap-2"
  >
    <Award size={14} />
    <span>CURSOS E CERTIFICAÇÕES</span>
  </h2>

  <div class="divide-y divide-edge-faint space-y-4">
    {courses.map(({ institution, title, period, desc }) => (
      <CourseItem
        title={title}
        period={period}
        desc={desc}
        institution={institution}
      />
    ))}
  </div>
</aside>
