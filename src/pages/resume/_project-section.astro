---
import { FolderGit2 } from '@lucide/astro';
import ProjectCard from '@/components/project-card.astro';
import { getFeaturedProjects } from '@/lib/github';

const projects = await getFeaturedProjects();
---

<section class="bg-surface border-edge border p-6 rounded-lg shadow-xl mt-6">
  <h2
    class="text-accent-600 font-black tracking-widest text-xs uppercase pb-2 flex items-center gap-2 border-edge-faint border-b"
  >
    <FolderGit2 size={14} />
    <span>Projetos</span>
  </h2>

  <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4 pt-4">
    {projects.map((project) => (
      <ProjectCard project={project} />
    ))}
  </div>
</section>
