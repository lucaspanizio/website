---
import Layout from '../../components/layout/index.astro';
import HomeNav from '../../components/layout/home-nav.astro';
import Footer from '../../components/layout/footer.astro';
import { Github, Linkedin, Mail, FolderGit2, ExternalLink, MapPin } from '@lucide/astro';
import type { Lang } from '../../i18n/utils';
import { translations } from '../../i18n/translations';

export function getStaticPaths() {
  return [
    { params: { lang: 'pt' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const tr = translations[lang] as any;
const base = import.meta.env.BASE_URL;

interface Project {
  slug: string;
  repo: string;
  demo?: string;
  tags: string[];
  type: 'frontend' | 'backend' | 'mobile' | 'library';
}

const projects: Project[] = [
  { slug: 'coffee-delivery', repo: 'https://github.com/lucaspanizio/coffee-delivery', demo: 'https://panizio-coffee-delivery.vercel.app', tags: ['React', 'TypeScript', 'Styled Components'], type: 'frontend' },
  { slug: 'forest-wind', repo: 'https://github.com/lucaspanizio/forest-wind', demo: 'https://lucaspanizio.github.io/forest-wind', tags: ['Astro', 'Tailwind CSS'], type: 'frontend' },
  { slug: 'kanban', repo: 'https://github.com/lucaspanizio/kanban', demo: 'https://panizio-kanban.vercel.app', tags: ['React', 'TypeScript', 'Styled Components', 'dnd-kit'], type: 'frontend' },
  { slug: 'nlw-expert-notes', repo: 'https://github.com/lucaspanizio/nlw-expert-notes', demo: 'https://panizio-nlw-expert-notes.vercel.app', tags: ['React', 'TypeScript', 'Tailwind CSS', 'Vite'], type: 'frontend' },
  { slug: 'passin-web', repo: 'https://github.com/lucaspanizio/nlw-unite-pass.in-react', demo: 'https://panizio-nlw-unite-pass-in-react.vercel.app', tags: ['React', 'TypeScript', 'TanStack Query', 'Tailwind CSS'], type: 'frontend' },
  { slug: 'flexblog', repo: 'https://github.com/lucaspanizio/flexblog', demo: 'https://lucaspanizio.github.io/flexblog', tags: ['CSS', 'Flexbox', 'HTML'], type: 'frontend' },
  { slug: 'calculator', repo: 'https://github.com/lucaspanizio/calculator', demo: 'https://panizio-calculator.vercel.app', tags: ['React', 'TypeScript', 'Styled Components'], type: 'frontend' },
  { slug: 'todo-web', repo: 'https://github.com/lucaspanizio/todo-web', tags: ['React', 'TypeScript', 'Styled Components'], type: 'frontend' },
  { slug: 'cert-generator', repo: 'https://github.com/lucaspanizio/gerador-certificados', tags: ['TypeScript'], type: 'frontend' },
  { slug: 'nlw-expert-polls', repo: 'https://github.com/lucaspanizio/nlw-expert-polls', tags: ['Node.js', 'TypeScript', 'WebSockets', 'Redis'], type: 'backend' },
  { slug: 'passin-api', repo: 'https://github.com/lucaspanizio/nlw-unite-pass.in-nodejs', tags: ['Node.js', 'TypeScript', 'Fastify', 'Prisma'], type: 'backend' },
  { slug: 'nlw-journey-app', repo: 'https://github.com/lucaspanizio/nlw-journey-app', tags: ['React Native', 'TypeScript', 'Expo', 'Tailwind CSS'], type: 'mobile' },
  { slug: 'use-enhance-children', repo: 'https://github.com/lucaspanizio/use-enhance-children', tags: ['React', 'TypeScript', 'Vitest'], type: 'library' },
  { slug: 'mf-lab', repo: 'https://github.com/lucaspanizio/mf-lab', tags: ['React', 'Angular', 'Vue 3', 'Module Federation'], type: 'frontend' },
];

const typeStyle: Record<Project['type'], string> = {
  frontend: 'bg-accent-50 border-accent-100 text-accent-700',
  backend: 'bg-success-50 border-success-100 text-success-700',
  mobile: 'bg-purple-50 border-purple-100 text-purple-700',
  library: 'bg-surface-tint border-edge text-ink-muted',
};

const filterTypes = ['all', 'frontend', 'backend', 'mobile', 'library'] as const;
---

<Layout
  title={tr.home.page_title}
  description={tr.home.page_desc}
  lang={lang}
>
  <HomeNav />

  <!-- HERO -->
  <section
    id="hero"
    class="relative min-h-screen flex flex-col items-center justify-center pt-16 px-6 text-center overflow-hidden"
  >
    <div
      class="absolute inset-0 -z-10"
      style="background-image: radial-gradient(#cbd5e1 1px, transparent 1px); background-size: 28px 28px;"
    ></div>
    <div class="absolute -top-24 -left-24 w-[480px] h-[480px] rounded-full bg-accent-100 opacity-50 blur-3xl -z-10"></div>
    <div class="absolute -bottom-24 -right-24 w-[420px] h-[420px] rounded-full bg-pink-100 opacity-50 blur-3xl -z-10"></div>
    <div class="absolute bottom-0 left-0 right-0 h-40 bg-gradient-to-t from-surface-tint to-transparent -z-10 pointer-events-none"></div>

    <div class="max-w-3xl mx-auto space-y-8">
      <div class="space-y-3">
        <p class="text-accent-600 font-mono text-sm font-bold tracking-[0.3em] uppercase" data-i18n="home.hero.greeting"></p>
        <h1 class="text-5xl md:text-7xl font-black text-ink-title leading-tight">
          José Lucas
          <span class="block bg-gradient-to-r from-accent-600 to-pink-600 bg-clip-text text-transparent">
            Panizio
          </span>
        </h1>
        <p class="text-base md:text-lg text-ink-subtle font-mono italic" data-i18n="hero.role"></p>
      </div>

      <p class="text-ink-body text-base md:text-lg leading-relaxed max-w-2xl mx-auto" data-i18n="home.hero.desc"></p>

      <div class="flex gap-3 justify-center">
        <a href="https://github.com/lucaspanizio" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="p-3 bg-surface border border-edge rounded-full text-ink-muted hover:text-accent-600 hover:border-accent-600 transition-all shadow-sm">
          <Github size={18} />
        </a>
        <a href="https://linkedin.com/in/lucaspanizio" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="p-3 bg-surface border border-edge rounded-full text-ink-muted hover:text-accent-600 hover:border-accent-600 transition-all shadow-sm">
          <Linkedin size={18} />
        </a>
        <a href="https://wa.me/5543996255495" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="p-3 bg-surface border border-edge rounded-full text-ink-muted hover:text-accent-600 hover:border-accent-600 transition-all shadow-sm">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
        </a>
        <a href="mailto:lucaspanizio@gmail.com" aria-label="Email" class="p-3 bg-surface border border-edge rounded-full text-ink-muted hover:text-accent-600 hover:border-accent-600 transition-all shadow-sm">
          <Mail size={18} />
        </a>
      </div>

      <div class="pt-4 flex justify-center">
        <a
          href="#about"
          data-i18n-aria-label="home.hero.scroll_aria"
          class="text-ink-subtle hover:text-accent-600 transition-colors text-2xl animate-bounce leading-none"
        >
          ↓
        </a>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="py-24 px-6 bg-surface">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-center gap-4 mb-14">
        <div class="h-px bg-edge w-8 shrink-0"></div>
        <h2 class="text-accent-600 font-black text-xs uppercase tracking-widest shrink-0" data-i18n="home.about.section_label"></h2>
        <div class="h-px bg-edge flex-1"></div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <div class="space-y-5">
          <h3 class="text-3xl font-black text-ink-title leading-snug">
            <span data-i18n="home.about.title"></span><br />
            <span class="text-accent-600" data-i18n="home.about.subtitle"></span>
          </h3>

          <p class="text-ink-body leading-relaxed" data-i18n="home.about.paragraph1"></p>
          <p class="text-ink-body leading-relaxed" data-i18n="home.about.paragraph2"></p>

          <div class="flex items-center gap-2 text-ink-muted text-sm">
            <MapPin size={14} />
            <span>Londrina, Paraná — Brasil</span>
          </div>

          <div class="pt-2">
            <a
              href={`${base}${lang}/resume/`}
              class="inline-flex items-center gap-2 text-accent-600 font-bold text-sm hover:underline"
              data-i18n="home.about.see_resume"
            ></a>
          </div>
        </div>

        <div class="space-y-6">
          {[
            { category: 'Frontend', items: ['React', 'TypeScript', 'JavaScript', 'HTML', 'CSS', 'Next.js', 'Astro', 'Tailwind CSS', 'Styled Components'] },
            { category: 'Backend', items: ['Node.js', 'REST APIs'] },
            { category: tr.home.skills.tools, items: ['Git', 'GitHub Actions', 'CI/CD', 'Storybook', 'Jest', 'Vitest', 'Vite'] },
          ].map((group) => (
            <div>
              <p class="text-xs font-bold tracking-widest uppercase text-ink-muted mb-3">
                {group.category}
              </p>
              <div class="flex flex-wrap gap-2">
                {group.items.map((skill) => (
                  <span class="bg-surface-tint border border-edge text-ink-body px-3 py-1 rounded-full text-xs font-medium">
                    {skill}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- PROJECTS -->
  <section id="projects" class="py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-center gap-4 mb-10">
        <div class="h-px bg-edge w-8 shrink-0"></div>
        <h2 class="text-accent-600 font-black text-xs uppercase tracking-widest shrink-0 flex items-center gap-2">
          <FolderGit2 size={13} />
          <span data-i18n="projects.title"></span>
        </h2>
        <div class="h-px bg-edge flex-1"></div>
      </div>

      <div class="flex flex-wrap gap-2 mb-8">
        {filterTypes.map((type) => (
          <button
            class={`filter-btn px-4 py-2 rounded-full text-xs font-bold border transition-all ${
              type === 'all'
                ? 'bg-accent-600 text-white border-accent-600'
                : 'border-edge text-ink-muted hover:border-accent-600 hover:text-accent-600'
            }`}
            data-filter={type}
          >
            {type === 'all' ? <span data-i18n="home.projects.filter_all"></span> : type}
          </button>
        ))}
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4" id="projects-grid">
        {projects.map((project) => (
          <div
            class="project-card border border-edge-faint rounded-lg p-4 flex flex-col gap-3 hover:border-accent-600/40 hover:shadow-sm transition-all bg-surface"
            data-type={project.type}
          >
            <div class="flex items-start justify-between gap-2">
              <div class="flex items-center gap-2 flex-wrap">
                <h3 class="text-ink-title font-bold text-sm" data-i18n={`project.${project.slug}.name`}></h3>
                <span class={`text-[9px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded border ${typeStyle[project.type]}`}>
                  {project.type}
                </span>
              </div>
              <div class="flex gap-2 shrink-0 mt-0.5">
                <a
                  href={project.repo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-ink-muted hover:text-accent-700 transition-colors"
                  data-i18n-title="home.projects.repo_title"
                >
                  <Github size={14} />
                </a>
                {project.demo && (
                  <a
                    href={project.demo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-ink-muted hover:text-accent-700 transition-colors"
                    data-i18n-title="home.projects.demo_title"
                  >
                    <ExternalLink size={14} />
                  </a>
                )}
              </div>
            </div>

            <p class="text-ink-body text-xs leading-relaxed flex-1" data-i18n={`project.${project.slug}.desc`}></p>

            <div class="flex flex-wrap gap-1">
              {project.tags.map((tag) => (
                <span class="bg-surface-tint border-edge text-ink-muted px-2 py-0.5 border rounded text-[9px] uppercase font-bold tracking-wider">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>

      <div class="text-center mt-10">
        <a
          href="https://github.com/lucaspanizio"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-ink-muted hover:text-accent-600 text-sm font-medium transition-colors border border-edge hover:border-accent-600 px-5 py-2.5 rounded-full"
        >
          <Github size={15} />
          <span data-i18n="home.projects.see_all"></span>
        </a>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="py-24 px-6 bg-surface">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-center gap-4 mb-14">
        <div class="h-px bg-edge w-8 shrink-0"></div>
        <h2 class="text-accent-600 font-black text-xs uppercase tracking-widest shrink-0" data-i18n="home.contact.section_label"></h2>
        <div class="h-px bg-edge flex-1"></div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <div class="space-y-6">
          <div class="space-y-3">
            <h3 class="text-3xl font-black text-ink-title" data-i18n="home.contact.heading"></h3>
            <p class="text-ink-body leading-relaxed" data-i18n="home.contact.description"></p>
          </div>

          <div class="space-y-3">
            <a href="https://wa.me/5543996255495" target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 p-4 bg-surface-tint border border-edge rounded-xl hover:border-green-400 hover:shadow-sm transition-all group">
              <div class="p-2.5 bg-green-50 rounded-lg text-green-600 group-hover:bg-green-100 transition-colors shrink-0">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/></svg>
              </div>
              <div>
                <p class="font-bold text-sm text-ink-title">WhatsApp</p>
                <p class="text-xs text-ink-muted font-mono">+55 43 99625-5495</p>
              </div>
            </a>

            <a href="https://linkedin.com/in/lucaspanizio" target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 p-4 bg-surface-tint border border-edge rounded-xl hover:border-accent-600 hover:shadow-sm transition-all group">
              <div class="p-2.5 bg-accent-50 rounded-lg text-accent-600 group-hover:bg-accent-100 transition-colors shrink-0">
                <Linkedin size={20} />
              </div>
              <div>
                <p class="font-bold text-sm text-ink-title">LinkedIn</p>
                <p class="text-xs text-ink-muted font-mono">/in/lucaspanizio</p>
              </div>
            </a>

            <a href="mailto:lucaspanizio@gmail.com" class="flex items-center gap-4 p-4 bg-surface-tint border border-edge rounded-xl hover:border-accent-600 hover:shadow-sm transition-all group">
              <div class="p-2.5 bg-surface-dim rounded-lg text-ink-muted group-hover:bg-accent-50 group-hover:text-accent-600 transition-colors shrink-0">
                <Mail size={20} />
              </div>
              <div>
                <p class="font-bold text-sm text-ink-title">Email</p>
                <p class="text-xs text-ink-muted font-mono">lucaspanizio@gmail.com</p>
              </div>
            </a>

            <a href="https://github.com/lucaspanizio" target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 p-4 bg-surface-tint border border-edge rounded-xl hover:border-accent-600 hover:shadow-sm transition-all group">
              <div class="p-2.5 bg-surface-dim rounded-lg text-ink-muted group-hover:bg-accent-50 group-hover:text-accent-600 transition-colors shrink-0">
                <Github size={20} />
              </div>
              <div>
                <p class="font-bold text-sm text-ink-title">GitHub</p>
                <p class="text-xs text-ink-muted font-mono">/lucaspanizio</p>
              </div>
            </a>
          </div>
        </div>

        <div class="bg-surface-tint border border-edge rounded-2xl p-6 md:p-8">
          <h3 class="text-lg font-black text-ink-title mb-6" data-i18n="home.contact.form_submit"></h3>
          <form
            id="contact-form"
            class="space-y-4"
            action="https://formspree.io/f/xzdlpqoj"
            method="POST"
          >
            <div>
              <label class="block text-xs font-bold text-ink-muted mb-1.5 uppercase tracking-wider" data-i18n="home.contact.form_name"></label>
              <input
                type="text"
                name="name"
                required
                data-i18n-placeholder="home.contact.form_name_ph"
                class="w-full bg-surface border border-edge rounded-lg px-4 py-2.5 text-sm text-ink-body placeholder:text-ink-subtle focus:outline-none focus:border-accent-600 transition-colors"
              />
            </div>
            <div>
              <label class="block text-xs font-bold text-ink-muted mb-1.5 uppercase tracking-wider" data-i18n="home.contact.form_email"></label>
              <input
                type="email"
                name="email"
                required
                data-i18n-placeholder="home.contact.form_email_ph"
                class="w-full bg-surface border border-edge rounded-lg px-4 py-2.5 text-sm text-ink-body placeholder:text-ink-subtle focus:outline-none focus:border-accent-600 transition-colors"
              />
            </div>
            <div>
              <label class="block text-xs font-bold text-ink-muted mb-1.5 uppercase tracking-wider" data-i18n="home.contact.form_message"></label>
              <textarea
                name="message"
                required
                rows={5}
                data-i18n-placeholder="home.contact.form_message_ph"
                class="w-full bg-surface border border-edge rounded-lg px-4 py-2.5 text-sm text-ink-body placeholder:text-ink-subtle focus:outline-none focus:border-accent-600 transition-colors resize-none"
              ></textarea>
            </div>
            <button
              id="submit-btn"
              type="submit"
              data-i18n="home.contact.form_submit"
              data-i18n-submit-text="home.contact.form_submit"
              data-i18n-sending-text="home.contact.form_sending"
              class="w-full bg-accent-600 hover:bg-accent-700 text-white py-3 rounded-lg font-bold text-sm transition-all shadow-sm"
            ></button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Success modal -->
  <div
    id="success-modal"
    class="fixed inset-0 z-[100] hidden"
    role="dialog"
    aria-modal="true"
    aria-labelledby="modal-title"
  >
    <div class="absolute inset-0 bg-surface-dark/60 backdrop-blur-sm" id="modal-backdrop"></div>
    <div class="relative flex items-center justify-center h-full p-4">
      <div class="bg-surface rounded-2xl p-8 max-w-sm w-full shadow-2xl text-center space-y-4">
        <div class="text-5xl">✅</div>
        <h3 id="modal-title" class="text-xl font-black text-ink-title" data-i18n="home.contact.success_title"></h3>
        <p class="text-ink-body text-sm leading-relaxed" data-i18n="home.contact.success_body"></p>
        <button
          id="close-modal"
          class="bg-accent-600 hover:bg-accent-700 text-white px-6 py-2.5 rounded-full font-bold text-sm transition-all"
          data-i18n="home.contact.success_close"
        ></button>
      </div>
    </div>
  </div>

  <Footer />
</Layout>

<script>
  const lang = document.documentElement.lang.startsWith('pt') ? 'pt' : 'en';
  localStorage.setItem('lang', lang);

  // Project filter
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const projectCards = document.querySelectorAll<HTMLElement>('.project-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter;

      filterBtns.forEach((b) => {
        b.classList.remove('bg-accent-600', 'text-white', 'border-accent-600');
        b.classList.add('border-edge', 'text-ink-muted');
      });
      btn.classList.add('bg-accent-600', 'text-white', 'border-accent-600');
      btn.classList.remove('border-edge', 'text-ink-muted');

      projectCards.forEach((card) => {
        if (filter === 'all' || card.dataset.type === filter) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    });
  });

  // Success modal
  const modal = document.getElementById('success-modal') as HTMLElement;
  const backdrop = document.getElementById('modal-backdrop');
  const closeBtn = document.getElementById('close-modal');

  function openModal() { modal.classList.remove('hidden'); }
  function closeModal() { modal.classList.add('hidden'); }

  closeBtn?.addEventListener('click', closeModal);
  backdrop?.addEventListener('click', closeModal);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });

  // Contact form
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const submitBtn = form?.querySelector<HTMLButtonElement>('#submit-btn');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (!submitBtn) return;
    const submitText = submitBtn.dataset.submitText ?? '';
    const sendingText = submitBtn.dataset.sendingText ?? '...';

    submitBtn.textContent = sendingText;
    submitBtn.disabled = true;

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });

      if (res.ok) {
        openModal();
        const message = form.elements.namedItem('message') as HTMLTextAreaElement;
        message.value = '';
        message.focus();
      }
    } finally {
      submitBtn.textContent = submitText;
      submitBtn.disabled = false;
    }
  });
</script>
