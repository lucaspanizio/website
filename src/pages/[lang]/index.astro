---
import { Mail, FolderGit2, ExternalLink, MapPin } from '@lucide/astro';
import { Image } from "astro:assets";

import GithubIcon from '@/components/icons/GithubIcon.astro';
import LinkedinIcon from '@/components/icons/LinkedinIcon.astro';
import WhatsappIcon from '@/components/icons/WhatsappIcon.astro';

import Layout from '@/components/layout/index.astro';
import HomeNav from '@/components/layout/home-nav.astro';
import Footer from '@/components/layout/footer.astro';
import type { Lang } from '@/i18n/utils';
import { translations } from '@/i18n/translations';

export function getStaticPaths() {
  return [
    { params: { lang: 'pt' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const tr = translations[lang] as any;
const base = import.meta.env.BASE_URL;

interface Project {
  slug: string;
  repo: string;
  demo?: string;
  tags: string[];
  type: 'frontend' | 'backend' | 'mobile' | 'library';
}

const projects: Project[] = [
  { slug: 'coffee-delivery', repo: 'https://github.com/lucaspanizio/coffee-delivery', demo: 'https://panizio-coffee-delivery.vercel.app', tags: ['React', 'TypeScript', 'Styled Components'], type: 'frontend' },
  { slug: 'forest-wind', repo: 'https://github.com/lucaspanizio/forest-wind', demo: 'https://lucaspanizio.github.io/forest-wind', tags: ['Astro', 'Tailwind CSS'], type: 'frontend' },
  { slug: 'kanban', repo: 'https://github.com/lucaspanizio/kanban', demo: 'https://panizio-kanban.vercel.app', tags: ['React', 'TypeScript', 'Styled Components', 'dnd-kit'], type: 'frontend' },
  { slug: 'nlw-expert-notes', repo: 'https://github.com/lucaspanizio/nlw-expert-notes', demo: 'https://panizio-nlw-expert-notes.vercel.app', tags: ['React', 'TypeScript', 'Tailwind CSS', 'Vite'], type: 'frontend' },
  { slug: 'passin-web', repo: 'https://github.com/lucaspanizio/nlw-unite-pass.in-react', demo: 'https://panizio-nlw-unite-pass-in-react.vercel.app', tags: ['React', 'TypeScript', 'TanStack Query', 'Tailwind CSS'], type: 'frontend' },
  { slug: 'flexblog', repo: 'https://github.com/lucaspanizio/flexblog', demo: 'https://lucaspanizio.github.io/flexblog', tags: ['CSS', 'Flexbox', 'HTML'], type: 'frontend' },
  { slug: 'calculator', repo: 'https://github.com/lucaspanizio/calculator', demo: 'https://panizio-calculator.vercel.app', tags: ['React', 'TypeScript', 'Styled Components'], type: 'frontend' },
  { slug: 'todo-web', repo: 'https://github.com/lucaspanizio/todo-web', tags: ['React', 'TypeScript', 'Styled Components'], type: 'frontend' },
  { slug: 'cert-generator', repo: 'https://github.com/lucaspanizio/gerador-certificados', tags: ['TypeScript'], type: 'frontend' },
  { slug: 'nlw-expert-polls', repo: 'https://github.com/lucaspanizio/nlw-expert-polls', tags: ['Node.js', 'TypeScript', 'WebSockets', 'Redis'], type: 'backend' },
  { slug: 'passin-api', repo: 'https://github.com/lucaspanizio/nlw-unite-pass.in-nodejs', tags: ['Node.js', 'TypeScript', 'Fastify', 'Prisma'], type: 'backend' },
  { slug: 'nlw-journey-app', repo: 'https://github.com/lucaspanizio/nlw-journey-app', tags: ['React Native', 'TypeScript', 'Expo', 'Tailwind CSS'], type: 'mobile' },
  { slug: 'use-enhance-children', repo: 'https://github.com/lucaspanizio/use-enhance-children', tags: ['React', 'TypeScript', 'Vitest'], type: 'library' },
  { slug: 'mf-lab', repo: 'https://github.com/lucaspanizio/mf-lab', tags: ['React', 'Angular', 'Vue 3', 'Module Federation'], type: 'frontend' },
];

const typeStyle: Record<Project['type'], string> = {
  frontend: 'bg-accent-50 border-accent-100 text-accent-700',
  backend: 'bg-success-50 border-success-100 text-success-700',
  mobile: 'bg-purple-50 border-purple-100 text-purple-700',
  library: 'bg-surface-tint border-edge text-ink-muted',
};

const filterTypes = ['all', 'frontend', 'backend', 'mobile', 'library'] as const;
---

<Layout
  title={tr.home.page_title}
  titleKey="home.page_title"
  description={tr.home.page_desc}
  lang={lang}
>
  <HomeNav />

  <!-- HERO -->
  <section
    id="hero"
    class="relative min-h-screen flex flex-col items-center justify-center pt-24 pb-4 px-6 text-center overflow-hidden"
  >
    <div
      class="absolute inset-0 -z-10"
      style="background-image: radial-gradient(#cbd5e1 1px, transparent 1px); background-size: 28px 28px;"
    ></div>
    <div class="absolute -top-24 -left-24 w-[480px] h-[480px] rounded-full bg-accent-100 opacity-50 blur-3xl -z-10"></div>
    <div class="absolute -bottom-24 -right-24 w-[420px] h-[420px] rounded-full bg-pink-100 opacity-50 blur-3xl -z-10"></div>
    <div class="absolute bottom-0 left-0 right-0 h-40 bg-gradient-to-t from-surface-tint to-transparent -z-10 pointer-events-none"></div>

    <div class="max-w-3xl mx-auto space-y-8">
      <div class="space-y-4">
        <p class="text-accent-600 font-mono text-sm font-bold tracking-[0.3em] uppercase" data-i18n="home.hero.greeting"></p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-6">
          <Image
            src={`${base}avatar.webp`}
            alt="Lucas Panizio"
            width={200}
            height={200}
            format="webp"
            decoding="async"
            fetchpriority="high"
            class="rounded-full object-cover ring-2 ring-edge ring-offset-2 shadow-md shrink-0"
          />
          <div class="text-center sm:text-left space-y-1">
            <h1 class="text-4xl md:text-6xl font-black text-ink-title leading-tight">
              José Lucas
              <span class="block bg-gradient-to-r from-accent-600 to-pink-600 bg-clip-text text-transparent">
                Panizio
              </span>
            </h1>
            <p class="text-base md:text-lg text-ink-subtle font-mono italic" data-i18n="hero.role"></p>
          </div>
        </div>
      </div>

      <p class="text-ink-body text-base md:text-lg leading-relaxed max-w-2xl mx-auto" data-i18n="home.hero.desc"></p>

      <div class="flex gap-3 justify-center">
        <a href="https://github.com/lucaspanizio" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="p-3 bg-surface border border-edge rounded-full text-ink-muted hover:text-gray-900 hover:border-gray-900 transition-all shadow-sm">
          <GithubIcon size={18} />
        </a>
        <a href="https://linkedin.com/in/lucaspanizio" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="p-3 bg-surface border border-edge rounded-full text-ink-muted hover:text-accent-600 hover:border-accent-600 transition-all shadow-sm">
          <LinkedinIcon size={18} />
        </a>
        <a href="https://wa.me/5543996255495" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="p-3 bg-surface border border-edge rounded-full text-ink-muted hover:text-green-600 hover:border-green-400 transition-all shadow-sm">
          <WhatsappIcon size={18} aria-hidden="true" />
        </a>
        <button id="hero-email-copy" aria-label="Email" class="p-3 bg-surface border border-edge rounded-full text-ink-muted hover:text-red-600 hover:border-red-500 transition-all shadow-sm cursor-pointer">
          <Mail size={18} />
        </button>
      </div>

      <div class="pt-4 flex justify-center">
        <a
          href="#about"
          data-i18n-aria-label="home.hero.scroll_aria"
          class="text-ink-subtle hover:text-accent-600 transition-colors text-2xl animate-bounce leading-none"
        >
          ↓
        </a>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="py-24 px-6 bg-surface">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-center gap-4 mb-14">
        <div class="h-px bg-edge w-8 shrink-0"></div>
        <h2 class="text-accent-600 font-black text-xs uppercase tracking-widest shrink-0" data-i18n="home.about.section_label"></h2>
        <div class="h-px bg-edge flex-1"></div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <div class="space-y-5">
          <h3 data-i18n="home.about.title" class="text-3xl font-black text-ink-title leading-snug">
          </h3>

          <p class="text-ink-body leading-relaxed" data-i18n="home.about.paragraph1"></p>
          <p class="text-ink-body leading-relaxed" data-i18n="home.about.paragraph2"></p>

          <div class="flex items-center gap-2 text-ink-muted text-sm">
            <MapPin size={14} />
            <span>Londrina, Paraná — Brasil</span>
          </div>

          <div class="pt-2">
            <a
              href={`${base}${lang}/resume/`}
              class="inline-flex items-center gap-2 text-accent-600 font-bold text-sm hover:underline"
              data-i18n="home.about.see_resume"
            ></a>
          </div>
        </div>

        <div class="space-y-6">
          {[
            { category: 'Frontend', items: ['HTML', 'CSS', 'JavaScript', 'TypeScript', 'React', 'Next.js', 'Astro', 'Tailwind CSS', 'Styled Components'] },
            { category: 'Backend', items: ['Node.js', 'Delphi', 'SQL', 'Prisma ORM', 'REST APIs'] },
            { category: tr.home.skills.tools, items: ['Git', 'GitHub Actions', 'Docker', 'Vite', 'Vitest', 'Jest', 'Testing Library', 'Storybook'] },
            { category: tr.home.skills.libraries, items: ['React Router Dom', 'React Hook Form', 'Zod', 'Tanstack Query', 'Zustand'] },
          ].map((group) => (
            <div>
              <p class="text-xs font-bold tracking-widest uppercase text-ink-muted mb-3">
                {group.category}
              </p>
              <div class="flex flex-wrap gap-2">
                {group.items.map((skill) => (
                  <span class="bg-surface-tint border border-edge text-ink-body px-3 py-1 rounded-full text-xs font-medium">
                    {skill}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- PROJECTS -->
  <section id="projects" class="py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-center gap-4 mb-10">
        <div class="h-px bg-edge w-8 shrink-0"></div>
        <h2 class="text-accent-600 font-black text-xs uppercase tracking-widest shrink-0 flex items-center gap-2">
          <FolderGit2 size={13} />
          <span data-i18n="projects.title"></span>
        </h2>
        <div class="h-px bg-edge flex-1"></div>
      </div>

      <div class="flex flex-wrap gap-2 mb-8">
        {filterTypes.map((type) => (
          <button
            class={`filter-btn px-4 py-2 rounded-full text-xs font-bold border transition-all ${
              type === 'all'
                ? 'bg-accent-600 text-white border-accent-600'
                : 'border-edge text-ink-muted hover:border-accent-600 hover:text-accent-600'
            }`}
            data-filter={type}
          >
            {type === 'all' ? <span data-i18n="home.projects.filter_all"></span> : type}
          </button>
        ))}
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4" id="projects-grid">
        {projects.map((project) => (
          <div
            class="project-card border border-edge-faint rounded-lg p-4 flex flex-col gap-3 hover:border-accent-600/40 hover:shadow-sm transition-all bg-surface"
            data-type={project.type}
          >
            <div class="flex items-start justify-between gap-2">
              <div class="flex items-center gap-2 flex-wrap">
                <h3 class="text-ink-title font-bold text-sm" data-i18n={`project.${project.slug}.name`}></h3>
                <span class={`text-[9px] font-bold uppercase tracking-wider px-1.5 py-0.5 rounded border ${typeStyle[project.type]}`}>
                  {project.type}
                </span>
              </div>
              <div class="flex gap-2 shrink-0 mt-0.5">
                <a
                  href={project.repo}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-ink-muted hover:text-accent-700 transition-colors"
                  data-i18n-title="home.projects.repo_title"
                >
                  <GithubIcon size={14} />
                </a>
                {project.demo && (
                  <a
                    href={project.demo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-ink-muted hover:text-accent-700 transition-colors"
                    data-i18n-title="home.projects.demo_title"
                  >
                    <ExternalLink size={14} />
                  </a>
                )}
              </div>
            </div>

            <p class="text-ink-body text-xs leading-relaxed flex-1" data-i18n={`project.${project.slug}.desc`}></p>

            <div class="flex flex-wrap gap-1">
              {project.tags.map((tag) => (
                <span class="bg-surface-tint border-edge text-ink-muted px-2 py-0.5 border rounded text-[9px] uppercase font-bold tracking-wider">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        ))}
      </div>

      <div class="text-center mt-10">
        <a
          href="https://github.com/lucaspanizio"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-ink-muted hover:text-accent-600 text-sm font-medium transition-colors border border-edge hover:border-accent-600 px-5 py-2.5 rounded-full"
        >
          <GithubIcon size={15} />
          <span data-i18n="home.projects.see_all"></span>
        </a>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="py-24 px-6 bg-surface">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-center gap-4 mb-14">
        <div class="h-px bg-edge w-8 shrink-0"></div>
        <h2 class="text-accent-600 font-black text-xs uppercase tracking-widest shrink-0" data-i18n="home.contact.section_label"></h2>
        <div class="h-px bg-edge flex-1"></div>
      </div>

      <div class="max-w-xl mx-auto text-center mb-6 space-y-4">
        <h3 class="text-3xl font-black text-ink-title" data-i18n="home.contact.heading"></h3>
        <p class="text-ink-body leading-relaxed" data-i18n="home.contact.description"></p>        
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-2xl mx-auto">
        <a href="https://wa.me/5543996255495" target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 p-5 bg-surface-tint border border-edge rounded-xl hover:border-green-400 hover:shadow-sm">
          <div class="p-3 bg-green-50 rounded-lg text-green-600">
            <WhatsappIcon size={22} aria-hidden="true" />
          </div>
          <div>
            <p class="font-bold text-sm text-ink-title">WhatsApp</p>
            <p class="text-xs text-ink-muted font-mono">+55 43 99625-5495</p>
          </div>
        </a>

        <a href="https://linkedin.com/in/lucaspanizio" target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 p-5 bg-surface-tint border border-edge rounded-xl hover:border-accent-600 hover:shadow-sm">
          <div class="p-3 bg-accent-50 rounded-lg text-accent-600">
            <LinkedinIcon size={22} />
          </div>
          <div>
            <p class="font-bold text-sm text-ink-title">LinkedIn</p>
            <p class="text-xs text-ink-muted font-mono">/in/lucaspanizio</p>
          </div>
        </a>

        <button id="contact-email-copy" class="flex items-center gap-4 p-5 bg-surface-tint border border-edge rounded-xl hover:border-red-500 hover:shadow-sm transition-all text-left cursor-pointer w-full">
          <div class="p-3 bg-rose-50 rounded-lg text-red-600 shrink-0">
            <Mail size={22} />
          </div>
          <div>
            <p class="font-bold text-sm text-ink-title">Email</p>
            <p class="text-xs text-ink-muted font-mono">lucaspanizio@gmail.com</p>
          </div>
        </button>

        <a href="https://github.com/lucaspanizio" target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 p-5 bg-surface-tint border border-edge rounded-xl hover:border-gray-900 hover:shadow-sm">
          <div class="p-3 bg-surface-dim rounded-lg text-gray-900">
            <GithubIcon size={22} />
          </div>
          <div>
            <p class="font-bold text-sm text-ink-title">GitHub</p>
            <p class="text-xs text-ink-muted font-mono">/lucaspanizio</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <div
    id="copy-toast"
    role="status"
    aria-live="polite"
    class="fixed bottom-6 left-1/2 -translate-x-1/2 z-[200] pointer-events-none opacity-0 translate-y-2 transition-all duration-300"
  >
    <div class="bg-surface-dark text-white px-5 py-2.5 rounded-full text-sm font-bold shadow-xl flex items-center gap-2">
      <span class="text-success-400">✓</span>
      <span data-i18n="home.hero.email_copied"></span>
    </div>
  </div>

  <Footer />
</Layout>

<script>
  const lang = document.documentElement.lang.startsWith('pt') ? 'pt' : 'en';
  localStorage.setItem('lang', lang);

  // Project filter
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const projectCards = document.querySelectorAll<HTMLElement>('.project-card');

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const filter = btn.dataset.filter;

      filterBtns.forEach((b) => {
        b.classList.remove('bg-accent-600', 'text-white', 'border-accent-600');
        b.classList.add('border-edge', 'text-ink-muted');
      });
      btn.classList.add('bg-accent-600', 'text-white', 'border-accent-600');
      btn.classList.remove('border-edge', 'text-ink-muted');

      projectCards.forEach((card) => {
        if (filter === 'all' || card.dataset.type === filter) {
          card.classList.remove('hidden');
        } else {
          card.classList.add('hidden');
        }
      });
    });
  });

  // Email copy to clipboard
  const toast = document.getElementById('copy-toast');
  let toastTimer: ReturnType<typeof setTimeout> | null = null;

  async function copyEmail() {
    try {
      await navigator.clipboard.writeText('lucaspanizio@gmail.com');
    } catch {
      const tmp = document.createElement('input');
      tmp.value = 'lucaspanizio@gmail.com';
      document.body.appendChild(tmp);
      tmp.select();
      document.execCommand('copy');
      document.body.removeChild(tmp);
    }

    if (!toast) return;
    if (toastTimer) clearTimeout(toastTimer);
    toast.classList.remove('opacity-0', 'translate-y-2');
    toast.classList.add('opacity-100', 'translate-y-0');
    toastTimer = setTimeout(() => {
      toast.classList.remove('opacity-100', 'translate-y-0');
      toast.classList.add('opacity-0', 'translate-y-2');
    }, 2000);
  }

  document.getElementById('hero-email-copy')?.addEventListener('click', copyEmail);
  document.getElementById('contact-email-copy')?.addEventListener('click', copyEmail);
</script>
