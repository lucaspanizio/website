---
import { BriefcaseBusiness } from '@lucide/astro';
---

<section class="flex-1 flex flex-col h-full bg-surface border-edge border p-6 rounded-lg shadow-xl">
  <h2
    class="text-accent-600 border-edge-faint font-black tracking-widest text-xs uppercase mb-6 border-b pb-2 flex items-center gap-2"
  >
    <BriefcaseBusiness size={14} />
    <span data-i18n="exp.title"></span>
  </h2>

  <div class="divide-y divide-edge-faint">

    <!-- Solus - Frontend -->
    <div class="border-edge-faint border-b py-6 last:border-0 group print:py-4 print-break-inside-avoid">
      <div class="flex justify-between items-start mb-1">
        <h3 class="text-ink-title font-bold text-sm sm:text-base">Solus Computação</h3>
        <span class="text-xxs sm:text-xs text-ink-muted font-mono italic whitespace-nowrap ml-4" data-i18n="exp.solus1.period"></span>
      </div>
      <p class="text-accent-600 text-xs uppercase tracking-wider font-bold mb-3" data-i18n="exp.solus1.role"></p>
      <div class="space-y-4">
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-1">
          <li class="text-ink-body text-xs flex gap-2"><span class="text-accent-600">&raquo;</span><span data-i18n="exp.solus1.duty.0"></span></li>
          <li class="text-ink-body text-xs flex gap-2"><span class="text-accent-600">&raquo;</span><span data-i18n="exp.solus1.duty.1"></span></li>
          <li class="text-ink-body text-xs flex gap-2"><span class="text-accent-600">&raquo;</span><span data-i18n="exp.solus1.duty.2"></span></li>
          <li class="text-ink-body text-xs flex gap-2"><span class="text-accent-600">&raquo;</span><span data-i18n="exp.solus1.duty.3"></span></li>
          <li class="text-ink-body text-xs flex gap-2"><span class="text-accent-600">&raquo;</span><span data-i18n="exp.solus1.duty.4"></span></li>
          <li class="text-ink-body text-xs flex gap-2"><span class="text-accent-600">&raquo;</span><span data-i18n="exp.solus1.duty.5"></span></li>
        </ul>
        <div class="bg-success-50/30 dark:bg-success-600/10 border-success-100 dark:border-success-600/30 p-4 rounded-lg border print:bg-success-50/10">
          <h4 class="text-success-700 dark:text-success-400 text-xxs font-bold uppercase mb-2 tracking-widest" data-i18n="exp.impact"></h4>
          <ul class="space-y-1">
            <li class="text-ink-strong text-xs flex gap-2"><span class="text-success-600">&#x2714;</span><span data-i18n="exp.solus1.impact.0"></span></li>
            <li class="text-ink-strong text-xs flex gap-2"><span class="text-success-600">&#x2714;</span><span data-i18n="exp.solus1.impact.1"></span></li>
          </ul>
        </div>
        <div class="flex flex-wrap gap-1 text-accent-700 text-xxs">
          {['React.js', 'Typescript', 'Styled Components', 'Tailwind CSS', 'Storybook', 'Vite', 'Git', 'Github'].map(tag => (
            <span class="bg-accent-50 dark:bg-accent-600/20 border-accent-100 dark:border-accent-600/30 text-accent-700 dark:text-accent-400 px-2 py-1 border rounded uppercase font-bold print:bg-surface-tint print:text-ink-strong print:border-edge text-[9px] tracking-wider">{tag}</span>
          ))}
        </div>
      </div>
    </div>

    <!-- Solus - Analista -->
    <div class="border-edge-faint border-b py-6 last:border-0 group print:py-4 print-break-inside-avoid">
      <div class="flex justify-between items-start mb-1">
        <h3 class="text-ink-title font-bold text-sm sm:text-base">Solus Computação</h3>
        <span class="text-xxs sm:text-xs text-ink-muted font-mono italic whitespace-nowrap ml-4" data-i18n="exp.solus2.period"></span>
      </div>
      <p class="text-accent-600 text-xs uppercase tracking-wider font-bold mb-3" data-i18n="exp.solus2.role"></p>
      <div class="space-y-4">
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-1">
          <li class="text-ink-body text-xs flex gap-2"><span class="text-accent-600">&raquo;</span><span data-i18n="exp.solus2.duty.0"></span></li>
          <li class="text-ink-body text-xs flex gap-2"><span class="text-accent-600">&raquo;</span><span data-i18n="exp.solus2.duty.1"></span></li>
          <li class="text-ink-body text-xs flex gap-2"><span class="text-accent-600">&raquo;</span><span data-i18n="exp.solus2.duty.2"></span></li>
        </ul>
        <div class="bg-success-50/30 dark:bg-success-600/10 border-success-100 dark:border-success-600/30 p-4 rounded-lg border print:bg-success-50/10">
          <h4 class="text-success-700 dark:text-success-400 text-xxs font-bold uppercase mb-2 tracking-widest" data-i18n="exp.impact"></h4>
          <ul class="space-y-1">
            <li class="text-ink-strong text-xs flex gap-2"><span class="text-success-600">&#x2714;</span><span data-i18n="exp.solus2.impact.0"></span></li>
            <li class="text-ink-strong text-xs flex gap-2"><span class="text-success-600">&#x2714;</span><span data-i18n="exp.solus2.impact.1"></span></li>
          </ul>
        </div>
        <div class="flex flex-wrap gap-1 text-accent-700 text-xxs">
          {['PL/SQL', 'Delphi', 'PHP', 'SVN'].map(tag => (
            <span class="bg-accent-50 dark:bg-accent-600/20 border-accent-100 dark:border-accent-600/30 text-accent-700 dark:text-accent-400 px-2 py-1 border rounded uppercase font-bold print:bg-surface-tint print:text-ink-strong print:border-edge text-[9px] tracking-wider">{tag}</span>
          ))}
        </div>
      </div>
    </div>

    <!-- Panizio -->
    <div class="border-edge-faint border-b py-6 last:border-0 group print:py-4 print-break-inside-avoid">
      <div class="flex justify-between items-start mb-1">
        <h3 class="text-ink-title font-bold text-sm sm:text-base">Panizio Transportes</h3>
        <span class="text-xxs text-ink-muted font-mono italic whitespace-nowrap ml-4" data-i18n="exp.panizio.period"></span>
      </div>
      <p class="text-accent-600 text-xs uppercase tracking-wider font-bold mb-3" data-i18n="exp.panizio.role"></p>
      <div class="space-y-4">
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-1">
          <li class="text-ink-body text-xs flex gap-2"><span class="text-accent-600">&raquo;</span><span data-i18n="exp.panizio.duty.0"></span></li>
          <li class="text-ink-body text-xs flex gap-2"><span class="text-accent-600">&raquo;</span><span data-i18n="exp.panizio.duty.1"></span></li>
          <li class="text-ink-body text-xs flex gap-2"><span class="text-accent-600">&raquo;</span><span data-i18n="exp.panizio.duty.2"></span></li>
        </ul>
      </div>
    </div>

    <!-- Apetit -->
    <div class="border-edge-faint border-b py-6 last:border-0 group print:py-4 print-break-inside-avoid">
      <div class="flex justify-between items-start mb-1">
        <h3 class="text-ink-title font-bold text-sm sm:text-base">Apetit Serviços de Alimentação</h3>
        <span class="text-xxs text-ink-muted font-mono italic whitespace-nowrap ml-4" data-i18n="exp.apetit.period"></span>
      </div>
      <p class="text-accent-600 text-xs uppercase tracking-wider font-bold mb-3" data-i18n="exp.apetit.role"></p>
      <div class="space-y-4">
        <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-6 gap-y-1">
          <li class="text-ink-body text-xs flex gap-2"><span class="text-accent-600">&raquo;</span><span data-i18n="exp.apetit.duty.0"></span></li>
          <li class="text-ink-body text-xs flex gap-2"><span class="text-accent-600">&raquo;</span><span data-i18n="exp.apetit.duty.1"></span></li>
        </ul>
      </div>
    </div>

  </div>
</section>
