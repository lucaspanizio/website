---
import Layout from '@/components/layout/index.astro';
import Header from '@/components/layout/header.astro';
import Footer from '@/components/layout/footer.astro';

import type { Lang } from '@/i18n/utils';
import { translations } from '@/i18n/translations';

import HeroSection from './_hero-section.astro';
import CourseSection from './_course-section.astro';
import GraduationSection from './_graduation-section.astro';
import ExperienceSection from './_experience-section.astro';
import ProjectSection from './_project-section.astro';

export function getStaticPaths() {
  return [
    { params: { lang: 'pt' } },
    { params: { lang: 'en' } },
  ];
}

const { lang } = Astro.params as { lang: Lang };
const tr = translations[lang] as any;
---

<Layout
  title={tr.resume.page_title}
  description={tr.resume.page_desc}
  lang={lang}
>
  <Header />

  <main class="max-w-[1200px] mx-auto px-4 pt-24 pb-8">
    <HeroSection />

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
      <div class="lg:col-span-7 flex flex-col gap-6">
        <GraduationSection />
        <ExperienceSection />
      </div>

      <CourseSection />
    </div>

    <ProjectSection />
  </main>

  <Footer />
</Layout>

<script>
  const lang = document.documentElement.lang.startsWith('pt') ? 'pt' : 'en';
  localStorage.setItem('lang', lang);
</script>
