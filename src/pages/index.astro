---
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Redirecionando...</title>
  </head>
  <body>
    <script is:inline define:vars={{ base }}>
      var savedLang = localStorage.getItem('lang') || localStorage.getItem('resume-lang');
      if (savedLang === 'pt' || savedLang === 'en') {
        localStorage.setItem('lang', savedLang);
        localStorage.removeItem('resume-lang');
      } else {
        var browserLang = (navigator.language || '').slice(0, 2).toLowerCase();
        savedLang = browserLang === 'pt' ? 'pt' : 'en';
        localStorage.setItem('lang', savedLang);
      }
      window.location.replace(base + savedLang + '/');
    </script>
    <noscript>
      <meta http-equiv="refresh" content="0;url=pt/" />
    </noscript>
  </body>
</html>
