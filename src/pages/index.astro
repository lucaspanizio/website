---
import { Mail, FolderGit2, MapPin, FileText, Menu, X } from '@lucide/astro';
import { Image } from "astro:assets";

import GithubIcon from '@/components/icons/GithubIcon.astro';
import LinkedinIcon from '@/components/icons/LinkedinIcon.astro';
import WhatsappIcon from '@/components/icons/WhatsappIcon.astro';

import Layout from '@/components/layout/index.astro';
import Header from '@/components/layout/header.astro';
import Footer from '@/components/layout/footer.astro';
import Button from '@/components/button.astro';
import ThemeToggle from '@/components/theme-toggle.astro';
import Logo from '@/components/logo.astro';
import ProjectCard from '@/components/project-card.astro';
import SkillsGrid from '@/components/skills-grid.astro';
import { getFeaturedProjects } from '@/lib/github';

const baseUrl = import.meta.env.BASE_URL;
const resumeUrl = `${baseUrl}resume/`;

const projects = await getFeaturedProjects();
---

<Layout>
  <Header id="home-nav">
    <Logo />

    <nav class="hidden md:flex items-center gap-1">
      <Button as="a" href="#about" variant="ghost">Sobre</Button>
      <Button as="a" href="#projects" variant="ghost">Projetos</Button>
      <Button as="a" href="#contact" variant="ghost">Contato</Button>
      <Button as="a" href={resumeUrl} variant="primary">
        <FileText size={13} />
        <span>Currículo</span>
      </Button>
      <ThemeToggle class="ml-3" />
    </nav>

    <button
      id="menu-toggle"
      class="md:hidden p-2 text-ink-body hover:text-accent-600 transition-colors"
      aria-label="Abrir menu"
    >
      <span id="icon-menu"><Menu size={20} /></span>
      <span id="icon-close" class="hidden"><X size={20} /></span>
    </button>
  </Header>

  <div
    id="mobile-menu"
    class="fixed top-16 left-0 right-0 z-40 bg-surface border-b border-edge shadow-lg hidden md:hidden"
  >
    <nav class="flex flex-col px-6 py-2">
      <Button as="a" href="#about" variant="ghost" class="mobile-nav-link">Sobre</Button>
      <Button as="a" href="#projects" variant="ghost" class="mobile-nav-link">Projetos</Button>
      <Button as="a" href="#contact" variant="ghost" class="mobile-nav-link">Contato</Button>

      <a href={resumeUrl} class="px-3 py-3.5 text-sm font-bold text-accent-600 flex items-center gap-2 border-b border-edge-faint">
        <FileText size={14} />
        <span>Currículo</span>
      </a>
      <div class="px-3 py-3.5 flex items-center gap-2">
        <ThemeToggle class="ml-auto" />
      </div>
    </nav>
  </div>

  <!-- HERO -->
  <section
    id="hero"
    class="relative min-h-screen flex flex-col items-center justify-center pt-24 pb-4 px-6 text-center overflow-hidden"
  >
    <div
      class="absolute inset-0 -z-10"
      style="background-image: radial-gradient(var(--color-edge-soft) 1px, transparent 1px); background-size: 28px 28px;"
    ></div>
    <div class="absolute -top-24 -left-24 w-[480px] h-[480px] rounded-full bg-accent-100 dark:bg-accent-600/15 opacity-50 blur-3xl -z-10"></div>
    <div class="absolute -bottom-24 -right-24 w-[420px] h-[420px] rounded-full bg-pink-100 dark:bg-pink-600/15 opacity-50 blur-3xl -z-10"></div>
    <div class="absolute bottom-0 left-0 right-0 h-40 bg-gradient-to-t from-surface-tint to-transparent -z-10 pointer-events-none"></div>

    <div class="max-w-3xl mx-auto space-y-8">
      <div class="space-y-4">
        <p class="text-accent-600 font-mono text-sm font-bold tracking-[0.3em] uppercase">Olá, eu sou</p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-6">
          <Image
            src={`${baseUrl}avatar.webp`}
            alt="Lucas Panizio"
            width={200}
            height={200}
            format="webp"
            decoding="async"
            fetchpriority="high"
            class="rounded-full object-cover ring-2 ring-edge ring-offset-2 shadow-md shrink-0"
          />
          <div class="text-center sm:text-left space-y-1">
            <h1 class="text-4xl md:text-6xl font-black text-ink-title leading-tight">
              José Lucas
              <span class="block bg-gradient-to-r from-accent-600 to-pink-600 bg-clip-text text-transparent">
                Panizio
              </span>
            </h1>
            <p class="text-base md:text-lg text-ink-subtle dark:text-ink-muted font-mono italic">Desenvolvedor de Software</p>
          </div>
        </div>
      </div>

      <p class="text-ink-body text-base md:text-lg leading-relaxed max-w-2xl mx-auto">Construo software com qualidade, simplicidade e longevidade.</p>

      <div class="flex gap-3 justify-center">
        <a href="https://github.com/lucaspanizio" target="_blank" rel="noopener noreferrer" aria-label="GitHub" class="p-3 bg-surface border border-edge rounded-full text-ink-muted hover:text-gray-900 hover:border-gray-900 dark:hover:text-accent-600 dark:hover:border-accent-600 transition-all shadow-sm">
          <GithubIcon size={18} />
        </a>
        <a href="https://linkedin.com/in/lucaspanizio" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="p-3 bg-surface border border-edge rounded-full text-ink-muted hover:text-accent-600 hover:border-accent-600 transition-all shadow-sm">
          <LinkedinIcon size={18} />
        </a>
        <a href="https://wa.me/5543996255495" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="p-3 bg-surface border border-edge rounded-full text-ink-muted hover:text-green-600 hover:border-green-400 dark:hover:text-accent-600 dark:hover:border-accent-600 transition-all shadow-sm">
          <WhatsappIcon size={18} aria-hidden="true" />
        </a>
        <button id="hero-email-copy" aria-label="Email" class="p-3 bg-surface border border-edge rounded-full text-ink-muted hover:text-red-600 hover:border-red-500 dark:hover:text-accent-600 dark:hover:border-accent-600 transition-all shadow-sm cursor-pointer">
          <Mail size={18} />
        </button>
      </div>

      <div class="pt-4 flex justify-center">
        <a
          href="#about"
          aria-label="Rolar para baixo"
          class="text-ink-subtle hover:text-accent-600 transition-colors text-2xl animate-bounce leading-none"
        >
          ↓
        </a>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="py-24 px-6 bg-surface">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-center gap-4 mb-14">
        <div class="h-px bg-edge w-8 shrink-0"></div>
        <h2 class="text-accent-600 font-black text-xs uppercase tracking-widest shrink-0">Sobre mim</h2>
        <div class="h-px bg-edge flex-1"></div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-[3fr_2fr] gap-12 items-start">
        <div class="space-y-5">
          <h3 class="text-3xl font-black text-ink-title leading-snug">
            Qualidade, clareza e evolução contínua
          </h3>

          <p class="text-ink-body leading-relaxed">Atuando principalmente no frontend, construo e evoluo aplicações web com React e TypeScript, priorizando <span class="underline decoration-accent-600/50 decoration-2 underline-offset-4">qualidade de código</span>, <span class="underline decoration-accent-600/50 decoration-2 underline-offset-4">clareza nas soluções</span> e uma arquitetura que facilite a <span class="underline decoration-accent-600/50 decoration-2 underline-offset-4">evolução do produto</span>. Busco desenvolver aplicações performáticas, com boa experiência para usuários e desenvolvedores, sempre alinhadas às necessidades do negócio.</p>

          <p class="text-ink-body leading-relaxed">Também participo de discussões técnicas, code reviews, definição de padrões e iniciativas que elevam a qualidade e a consistência do código da equipe.</p>

          <p class="text-ink-body leading-relaxed">Acredito no aprendizado contínuo e estou sempre explorando novas tecnologias, conceitos e boas práticas, atualmente aprofundando meus conhecimentos em Node.js para expandir minha atuação como desenvolvedor full stack.</p>

          <div class="flex items-center gap-2 text-ink-muted text-sm">
            <MapPin size={14} />
            <span>Londrina, Paraná — Brasil</span>
          </div>

          <div class="pt-2">
            <a
              href={resumeUrl}
              class="inline-flex items-center gap-2 text-accent-600 font-bold text-sm hover:underline"
            >Ver currículo completo →</a>
          </div>
        </div>

        <SkillsGrid />
      </div>
    </div>
  </section>

  <!-- PROJECTS -->
  <section id="projects" class="py-24 px-6">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-center gap-4 mb-10">
        <div class="h-px bg-edge w-8 shrink-0"></div>
        <h2 class="text-accent-600 font-black text-xs uppercase tracking-widest shrink-0 flex items-center gap-2">
          <FolderGit2 size={13} />
          <span>Projetos</span>
        </h2>
        <div class="h-px bg-edge flex-1"></div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-3 gap-4">
        {projects.map((project) => (
          <ProjectCard project={project} />
        ))}
      </div>

      <div class="text-center mt-10">
        <a
          href="https://github.com/lucaspanizio"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-ink-muted hover:text-accent-600 text-sm font-medium transition-colors border border-edge hover:border-accent-600 px-5 py-2.5 rounded-full"
        >
          <GithubIcon size={15} />
          <span>Ver todos no GitHub</span>
        </a>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="py-24 px-6 bg-surface">
    <div class="max-w-6xl mx-auto">
      <div class="flex items-center gap-4 mb-14">
        <div class="h-px bg-edge w-8 shrink-0"></div>
        <h2 class="text-accent-600 font-black text-xs uppercase tracking-widest shrink-0">Contato</h2>
        <div class="h-px bg-edge flex-1"></div>
      </div>

      <div class="max-w-xl mx-auto text-center mb-6 space-y-4">
        <h3 class="text-3xl font-black text-ink-title">Vamos conversar?</h3>
        <p class="text-ink-body leading-relaxed">Estou sempre aberto a conversar sobre projetos, oportunidades e desenvolvimento de software. Se acredita que podemos construir algo interessante juntos, entre em contato.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-2xl mx-auto">
        <a href="https://wa.me/5543996255495" target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 p-5 bg-surface-tint border border-edge rounded-xl hover:border-green-400 dark:hover:border-accent-600 hover:shadow-sm">
          <div class="p-3 bg-green-50 dark:bg-green-600/20 rounded-lg text-green-600 dark:text-green-400">
            <WhatsappIcon size={22} aria-hidden="true" />
          </div>
          <div>
            <p class="font-bold text-sm text-ink-title">WhatsApp</p>
            <p class="text-xs text-ink-muted font-mono">+55 43 99625-5495</p>
          </div>
        </a>

        <a href="https://linkedin.com/in/lucaspanizio" target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 p-5 bg-surface-tint border border-edge rounded-xl hover:border-accent-600 hover:shadow-sm">
          <div class="p-3 bg-accent-50 dark:bg-accent-600/20 rounded-lg text-accent-600 dark:text-accent-400">
            <LinkedinIcon size={22} />
          </div>
          <div>
            <p class="font-bold text-sm text-ink-title">LinkedIn</p>
            <p class="text-xs text-ink-muted font-mono">/in/lucaspanizio</p>
          </div>
        </a>

        <button id="contact-email-copy" class="flex items-center gap-4 p-5 bg-surface-tint border border-edge rounded-xl hover:border-red-500 dark:hover:border-accent-600 hover:shadow-sm transition-all text-left cursor-pointer w-full">
          <div class="p-3 bg-rose-50 dark:bg-rose-600/20 rounded-lg text-red-600 dark:text-red-400 shrink-0">
            <Mail size={22} />
          </div>
          <div>
            <p class="font-bold text-sm text-ink-title">Email</p>
            <p class="text-xs text-ink-muted font-mono">lucaspanizio@gmail.com</p>
          </div>
        </button>

        <a href="https://github.com/lucaspanizio" target="_blank" rel="noopener noreferrer" class="flex items-center gap-4 p-5 bg-surface-tint border border-edge rounded-xl hover:border-gray-900 dark:hover:border-accent-600 hover:shadow-sm">
          <div class="p-3 bg-surface-dim rounded-lg text-gray-900 dark:text-gray-200">
            <GithubIcon size={22} />
          </div>
          <div>
            <p class="font-bold text-sm text-ink-title">GitHub</p>
            <p class="text-xs text-ink-muted font-mono">/lucaspanizio</p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <div
    id="copy-toast"
    role="status"
    aria-live="polite"
    class="fixed bottom-6 left-1/2 -translate-x-1/2 z-[200] pointer-events-none opacity-0 translate-y-2 transition-all duration-300"
  >
    <div class="bg-surface-dark text-white px-5 py-2.5 rounded-full text-sm font-bold shadow-xl flex items-center gap-2">
      <span class="text-success-400">✓</span>
      <span>Email copiado!</span>
    </div>
  </div>

  <Footer />
</Layout>

<script>
  // Email copy to clipboard
  const toast = document.getElementById('copy-toast');
  let toastTimer: ReturnType<typeof setTimeout> | null = null;

  async function copyEmail() {
    try {
      await navigator.clipboard.writeText('lucaspanizio@gmail.com');
    } catch {
      const tmp = document.createElement('input');
      tmp.value = 'lucaspanizio@gmail.com';
      document.body.appendChild(tmp);
      tmp.select();
      document.execCommand('copy');
      document.body.removeChild(tmp);
    }

    if (!toast) return;
    if (toastTimer) clearTimeout(toastTimer);
    toast.classList.remove('opacity-0', 'translate-y-2');
    toast.classList.add('opacity-100', 'translate-y-0');
    toastTimer = setTimeout(() => {
      toast.classList.remove('opacity-100', 'translate-y-0');
      toast.classList.add('opacity-0', 'translate-y-2');
    }, 2000);
  }

  document.getElementById('hero-email-copy')?.addEventListener('click', copyEmail);
  document.getElementById('contact-email-copy')?.addEventListener('click', copyEmail);
</script>

<script>
  document.querySelectorAll('[data-theme-toggle]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
    });
  });

  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');

  function closeMenu() {
    menu?.classList.add('hidden');
    iconMenu?.classList.remove('hidden');
    iconClose?.classList.add('hidden');
  }

  toggle?.addEventListener('click', () => {
    const isOpen = !menu?.classList.contains('hidden');
    if (isOpen) {
      closeMenu();
    } else {
      menu?.classList.remove('hidden');
      iconMenu?.classList.add('hidden');
      iconClose?.classList.remove('hidden');
    }
  });

  document.querySelectorAll('.mobile-nav-link').forEach(link => {
    link.addEventListener('click', closeMenu);
  });

  document.addEventListener('click', (event) => {
    if (menu?.classList.contains('hidden')) return;
    const target = event.target as Node;
    if (menu?.contains(target) || toggle?.contains(target)) return;
    closeMenu();
  });
</script>

<script>
  import { PROJECT_TITLE } from "@/data/config";

  // Atualiza URL e título da aba conforme a seção visível durante o scroll/touch
  const sectionTitles: Record<string, string> = {
    hero: PROJECT_TITLE,
    about: `${PROJECT_TITLE} | Sobre`,
    projects: `${PROJECT_TITLE} | Projetos`,
    contact: `${PROJECT_TITLE} | Contato`,
  };

  const sections = Array.from(document.querySelectorAll('section[id]'));

  const sectionObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;

        const id = entry.target.id;
        const title = sectionTitles[id] || PROJECT_TITLE;
        document.title = title;

        const hash = id === 'hero' ? '' : `#${id}`;
        if (window.location.hash !== hash) {
          const url = `${window.location.pathname}${window.location.search}${hash}`;
          history.replaceState(history.state, '', url);
        }
      });
    },
    { rootMargin: '-45% 0px -50% 0px', threshold: 0 }
  );

  sections.forEach((section) => sectionObserver.observe(section));
</script>
